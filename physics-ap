        (function() {
            // إذا كان المستخدم قد فتح الملف في هذه الجلسة، لا نعرض شاشة القفل
            if (sessionStorage.getItem('unlocked') === 'true') {
                document.getElementById('lockScreen').style.display = 'none';
                return;
            }

            // حفظ تاريخ أول فتح (إن لم يكن موجوداً)
            let firstOpenDate = localStorage.getItem('firstOpenDate');
            if (!firstOpenDate) {
                firstOpenDate = Date.now();
                localStorage.setItem('firstOpenDate', firstOpenDate);
            }

            // حساب عدد الأيام المنقضية منذ أول فتح
            const daysElapsed = Math.floor((Date.now() - firstOpenDate) / (1000 * 60 * 60 * 24));

            // تحديد الرمز الحالي:
            // الأيام الزوجية (0، 2، 4...) → 123
            // الأيام الفردية (1، 3، 5...) → 321
            const correctPin = (daysElapsed % 2 === 0) ? '123': '321';

            // دالة التحقق
            window.verifyPin = function() {
                const p1 = document.getElementById('pin1').value;
                const p2 = document.getElementById('pin2').value;
                const p3 = document.getElementById('pin3').value;
                const entered = p1 + p2 + p3;

                if (entered === correctPin) {
                    sessionStorage.setItem('unlocked', 'true');
                    document.getElementById('lockScreen').style.display = 'none';
                } else {
                    document.getElementById('pinError').textContent = '❌ الرمز غير صحيح. حاول مرة أخرى.';
                    document.getElementById('pin1').value = '';
                    document.getElementById('pin2').value = '';
                    document.getElementById('pin3').value = '';
                    document.getElementById('pin1').focus();
                }
            };

            // تحسين التجربة: الانتقال التلقائي بين الخانات
            const pins = ['pin1',
                'pin2',
                'pin3'];
            pins.forEach((id, index) => {
                const el = document.getElementById(id);
                el.addEventListener('input', (e) => {
                    const val = e.target.value.replace(/\D/g, '');
                    e.target.value = val.slice(-1);
                    if (val && index < pins.length - 1) {
                        document.getElementById(pins[index + 1]).focus();
                    }
                    // الدخول التلقائي عند اكتمال 3 أرقام
                    if (index === pins.length - 1 && val && document.getElementById('pin1').value && document.getElementById('pin2').value) {
                        verifyPin();
                    }
                });
                el.addEventListener('keydown',
                    (e) => {
                        if (e.key === 'Backspace' && !e.target.value && index > 0) {
                            document.getElementById(pins[index - 1]).focus();
                        }
                    });
            });

            document.getElementById('pin1').focus();
        })();

