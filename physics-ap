                    `).join('')}
                </div>
                </div>
                `).join('');
        }

        function renderMatch() {
            const container = document.getElementById('matchContainer');
            const lefts = matchPairs.map(p => p.left);
            const rights = matchPairs.map(p => p.right).sort(() => Math.random() - 0.5);

            container.innerHTML = `
            <div class="match-column">
            <h4 style="text-align:center; margin-bottom:0.5rem; color:var(--primary);">المفهوم</h4>
            ${lefts.map((l, i) => `<div class="match-item">${l}</div>`).join('')}
            </div>
            <div class="match-column">
            <h4 style="text-align:center; margin-bottom:0.5rem; color:var(--primary);">الاختيار</h4>
            ${lefts.map((_, i) => `
                <div class="match-item" style="padding:0.4rem;">
                <select class="match-select" id="match_${i}">
                <option value="">-- اختر --</option>
                ${rights.map((r, j) => `<option value="${r}">${r}</option>`).join('')}
                </select>
                </div>
                `).join('')}
            </div>
            `;
        }

        renderQuestions('c1-questions', questionsC1, 'c1');
        renderQuestions('c2-questions', questionsC2, 'c2');
        renderQuestions('c3-questions', questionsC3, 'c3');
        renderQuestions('c4-questions', questionsC4, 'c4');
        renderMatch();

        /* =====================================================
   الجزء 6: منطق التقييم ونظام الحظر
   ===================================================== */
        function checkAttempts(stage, lockEl) {
            const now = Date.now();
            const state = attempts[stage];

            if (now < state.lockUntil) {
                const remaining = Math.ceil((state.lockUntil - now) / 1000);
                const mins = Math.floor(remaining / 60);
                const secs = remaining % 60;
                lockEl.textContent = `⛔ لا يمكنك إعادة المحاولة الآن. يرجى الانتظار ${mins} دقيقة و ${secs} ثانية.`;
                lockEl.style.display = 'block';
                return false;
            }

            if (state.count >= MAX_ATTEMPTS) {
                state.lockUntil = now + LOCK_TIME_MS;
                state.count = 0;
                lockEl.textContent = `⛔ لقد استنفدت محاولاتك. يرجى الانتظار 15 دقيقة قبل إعادة المحاولة.`;
                lockEl.style.display = 'block';
                return false;
            }

            lockEl.style.display = 'none';
            state.count++;
            return true;
        }

        function checkQuestions(stage, questions, groupName, btnId, feedbackId, lockId, pointsPerQ, nextScreen) {
            const lockEl = document.getElementById(lockId);

            if (!checkAttempts(stage, lockEl)) return;

            let correctCount = 0;
            let total = questions.length;

            questions.forEach((q, i) => {
                const selected = document.querySelector(`input[name="${groupName}_q${i}"]:checked`);
                if (selected && +selected.value === q.ans) {
                    correctCount++;
                }
            });

            const percentage = (correctCount / total) * 100;
            const earnedPoints = correctCount * pointsPerQ;
            updateScore(earnedPoints);

            const passed = percentage >= 50;
            const msg = `أجبت بشكل صحيح على ${correctCount} من ${total} أسئلة (${percentage.toFixed(0)}%). حصلت على ${earnedPoints} نقطة. ${passed ? '✅ نجحت في المحطة!': '❌ لم تحقق 50% المطلوبة للانتقال.'}`;

            showFeedback(feedbackId,
                msg,
                passed);

            if (passed && nextScreen) {
                setTimeout(() => goToScreen(nextScreen), 2500);
            } else {
                const state = attempts[stage];
                if (state.count >= MAX_ATTEMPTS) {
                    const now = Date.now();
                    state.lockUntil = now + LOCK_TIME_MS;
                    state.count = 0;
                    lockEl.textContent = `⛔ لقد استنفدت محاولاتك لهذه المحطة. يرجى الانتظار 15 دقيقة.`;
                    lockEl.style.display = 'block';
                }
            }
        }

        function submitChallenge1() {
            checkQuestions(1, questionsC1, 'c1', 'c1-btn', 'c1-feedback', 'c1-lock', 10, 'screen-challenge2');
        }
        function submitChallenge2() {
            checkQuestions(2, questionsC2, 'c2', 'c2-btn', 'c2-feedback', 'c2-lock', 15, 'screen-challenge3');
        }
        function submitChallenge3() {
            checkQuestions(3, questionsC3, 'c3', 'c3-btn', 'c3-feedback', 'c3-lock', 15, 'screen-challenge4');
        }

        function submitChallenge4() {
            const lockEl = document.getElementById('c4-lock');
            if (!checkAttempts(4, lockEl)) return;

            let matchCorrect = 0;
            matchPairs.forEach((pair, i) => {
                const selected = document.getElementById(`match_${i}`).value;
                if (selected === pair.right) matchCorrect++;
            });

            let reasonCorrect = 0;
            questionsC4.forEach((q, i) => {
                const selected = document.querySelector(`input[name="c4_q${i}"]:checked`);
                if (selected && +selected.value === q.ans) reasonCorrect++;
            });

            const totalItems = matchPairs.length + questionsC4.length;
            const totalCorrect = matchCorrect + reasonCorrect;
            const percentage = (totalCorrect / totalItems) * 100;
            const earned = (matchCorrect + reasonCorrect) * 10;
            updateScore(earned);

            const passed = percentage >= 50;
            const msg = `المزاوجة: ${matchCorrect}/${matchPairs.length} | العلل: ${reasonCorrect}/${questionsC4.length}. حصلت على ${earned} نقطة (${percentage.toFixed(0)}%). ${passed ? '✅ نجحت في المحطة!': '❌ لم تحقق 50% المطلوبة.'}`;
            showFeedback('c4-feedback',
                msg,
                passed);

            if (passed) {
                setTimeout(() => showFinalResults(), 2500);
            } else {
                const state = attempts[4];
                if (state.count >= MAX_ATTEMPTS) {
                    const now = Date.now();
                    state.lockUntil = now + LOCK_TIME_MS;
                    state.count = 0;
                    lockEl.textContent = `⛔ لقد استنفدت محاولاتك لهذه المحطة. يرجى الانتظار 15 دقيقة.`;
                    lockEl.style.display = 'block';
                }
            }
        }

        /* =====================================================
   الجزء 7: شاشة النتائج النهائية
   ===================================================== */
        function showFinalResults() {
            clearInterval(timerInterval);

            document.getElementById('resName').textContent = studentData.name;
            document.getElementById('resSchool').textContent = studentData.school;
            document.getElementById('resSection').textContent = studentData.section || 'غير محدد';

            const mins = Math.floor(seconds / 60).toString().padStart(2, '0');
            const secs = (seconds % 60).toString().padStart(2, '0');
            document.getElementById('resTime').textContent = `${mins}:${secs}`;

            document.getElementById('finalScore').textContent = score;

            let msg = '';
            if (score >= 350) msg = '🏅 مهندس فيزيائي متميز! أداء استثنائي.';
            else if (score >= 250) msg = '🌟 مهندس متقن! أداء جيد جداً.';
            else if (score >= 150) msg = '👍 جيد، تحتاج لمراجعة بعض القوانين.';
            else msg = '📖 تحتاج إلى إعادة مراجعة الدروس وحل المزيد من التمارين.';

            document.getElementById('finalMessage').textContent = msg;

            goToScreen('screen-result');
        }

        /* =====================================================
   الجزء 8: تسجيل Service Worker (PWA)
   ===================================================== */
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('sw.js')
                .then((reg) => console.log('🚀 التطبيق جاهز للعمل بدون إنترنت:', reg.scope))
                .catch((err) => console.log('⚠️ فشل تسجيل Service Worker:', err));
            });
        }
    </script>
</body>
